{
  "profile": {
    "name": "Дмитрий",
    "nick": "Dima404",
    "role": "системный администратор в процессе",
    "city": "Оренбург",
    "born": "14.05.2008",
    "tagline": "Собираю, разбираю, слушаю жёсткий бас и смотрю слишком много аниме про попаданцев.",
    "about": "Студент-сисадмин из Оренбурга. Люблю технику, музыку на грани hardstyle и breakcore, длинные ночи в играх и разговоры про дизайн интерфейсов. Этот сайт — карточка себя: что слушаю, во что играю, что смотрю и из чего состоит моё железо."
  },
  "timeline": [
    {
      "year": "2008",
      "title": "Родился раньше срока",
      "text": "14 мая, Оренбург. На три месяца раньше срока — с этого и начинается весь лор."
    },
    {
      "year": "2014–2018",
      "title": "Интернат, 1–4 класс",
      "text": "Начальная школа прошла в интернате: научился жить самостоятельно раньше большинства сверстников."
    },
    {
      "year": "после 2018",
      "title": "Гимназия на домашнем обучении",
      "text": "После травмы правого глаза перешёл на домашнее обучение — иногда чередовал с обычным классом."
    },
    {
      "year": "2023",
      "title": "Steam-аккаунт и первые сотни часов",
      "text": "Ноябрь 2023 — регистрация основного профиля. Дальше понеслось: игры, друзья, ночные катки."
    },
    {
      "year": "2024",
      "title": "Колледж: разработчик электронных устройств",
      "text": "1–2 курс по специальности «Разработчик электронных устройств и систем». Понял, что железяки интереснее, чем схемы по методичке."
    },
    {
      "year": "2025",
      "title": "Перевод на системного администратора",
      "text": "Перевёлся на сисадмина: сети, серверы, обслуживание техники — то, что реально нравится."
    },
    {
      "year": "2026",
      "title": "18 лет и этот сайт",
      "text": "Собрал личный сайт, чтобы не рассказывать одно и то же по кругу. Дальше — только вперёд."
    }
  ],
